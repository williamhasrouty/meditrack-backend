# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
# Development: local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/meditrack
# Production: use your production MongoDB URI

# JWT Secret
# IMPORTANT: Use a strong, unique secret key for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your-secret-key-here

# Encryption Key for PHI (REQUIRED in production)
# CRITICAL: Use different keys for development, staging, and production
# CRITICAL: Store production keys in secure secrets manager (AWS Secrets Manager, Azure Key Vault, etc.)
# CRITICAL: Never commit production keys to version control
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# CORS Configuration (optional)
# FRONTEND_URL=https://meditrack.jumpingcrab.com
